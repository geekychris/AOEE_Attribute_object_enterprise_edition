# AOEE Spring Boot REST proxy (Java)
# Multi-stage maven build then a slim JRE runtime. Build context is the AOEE repo root.
FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /src
COPY aoee-spring /src/aoee-spring
WORKDIR /src/aoee-spring
RUN mvn -DskipTests -B package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=builder /src/aoee-spring/target/aoee-spring-0.1.0.jar /app/app.jar
ENV SERVER_PORT=8081 \
    AOEE_HOST=aoee-server \
    AOEE_PORT=50051
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
