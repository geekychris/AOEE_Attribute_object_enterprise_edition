FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /app
COPY aoee-java-client/ ./aoee-java-client/
COPY aoee-spring/ ./aoee-spring/
RUN cd aoee-java-client && mvn install -DskipTests -q
RUN cd aoee-spring && mvn package -DskipTests -q

FROM eclipse-temurin:21-jre
COPY --from=builder /app/aoee-spring/target/*.jar /app/aoee-proxy.jar
ENV SERVER_PORT=8082
EXPOSE 8082
# Shell form so ${SERVER_PORT} is expanded at start, letting orchestrators
# (k8s envFrom, docker run -e) override the listen port without rebuilding.
# Spring's hardcoded `--server.port=` CLI arg used to win over SERVER_PORT env,
# breaking deployments that set the env to a non-default port.
CMD exec java -jar /app/aoee-proxy.jar --server.port=${SERVER_PORT}
